<?xml version="1.0" encoding="UTF-8"?>
<!--
  =============================================================================
   pom.xml · Archivo de configuración de MAVEN
  ·············································································
   Maven es la herramienta que:
     1. Descarga las librerías (dependencias) que necesita el proyecto.
     2. Compila el código, ejecuta las pruebas y empaqueta la aplicación.

   POM = Project Object Model. Aquí describimos QUÉ es nuestro proyecto
   (nombre, versión) y QUÉ necesita (dependencias y plugins).

   Comandos útiles (desde la carpeta firstapi):
       ./mvnw spring-boot:run   → ejecuta la API
       ./mvnw test              → ejecuta las pruebas
       ./mvnw package           → genera el .jar dentro de target/
  =============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  PROYECTO PADRE: heredamos la configuración base de Spring Boot.
	  Gracias a esto NO tenemos que escribir la versión de cada dependencia
	  de Spring: el padre ya sabe qué versiones funcionan bien juntas.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- busca el padre en el repositorio de Maven -->
	</parent>

	<!-- IDENTIDAD DEL PROYECTO: grupo (dominio invertido) + nombre + versión -->
	<groupId>ni.cinicaragua</groupId>
	<artifactId>firstapi</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>firstapi</name>
	<description>Primera API REST con Spring Boot · Curso Backend con Java · CI Nicaragua</description>

	<properties>
		<!--
		  Versión de Java con la que se compila el proyecto.
		  Spring Boot 4 necesita Java 17 como mínimo. Usamos 17 para que
		  funcione en cualquier computadora del curso (JDK 17, 21, 25...).
		-->
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<!-- ===================== DEPENDENCIAS PRINCIPALES ===================== -->

		<!-- WEB MVC: permite crear controladores y endpoints REST (@RestController,
		     @GetMapping...). Incluye un servidor Tomcat embebido y Jackson para
		     convertir objetos Java a JSON automáticamente. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- VALIDATION: permite validar los datos que llegan a la API con
		     anotaciones como @NotBlank, @Email, @Min, @Max... -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- DATA JPA: para guardar datos en una base de datos usando clases Java
		     (@Entity). Lo usaremos en la clase de bases de datos. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- H2: base de datos que vive en memoria. Ideal para practicar: no hay
		     que instalar nada, pero los datos se borran al apagar la aplicación. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- CONSOLA H2: página web para ver la base de datos H2 en
		     http://localhost:8080/h2-console -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
		</dependency>

		<!-- ===================== HERRAMIENTAS DE DESARROLLO ===================== -->

		<!-- DEVTOOLS: reinicia la aplicación automáticamente cuando guardamos
		     cambios. Solo se usa mientras desarrollamos. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- LOMBOK: genera getters, setters y constructores con anotaciones
		     (@Getter, @Setter, @Data...). En este proyecto escribimos los getters
		     a mano para entender el encapsulamiento; más adelante lo usaremos. -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- ===================== PRUEBAS (solo para tests) ===================== -->

		<!-- Incluye JUnit, MockMvc y AssertJ para probar los endpoints -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Permite ejecutar la app con "./mvnw spring-boot:run" y
			     empaquetarla como un .jar ejecutable -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Compilador de Java: le indicamos que use Lombok para generar código -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
